

# ========= Figure / save =========
figure.dpi: 300
figure.autolayout: True
savefig.bbox: tight

# ========= Fonts =========
text.usetex: False
font.size: 9
font.family: serif

# ========= Lines =========
lines.linewidth: 0.8

# ========= Grid =========
grid.linewidth: 0.5
grid.color: black
grid.alpha: 0.2

# ========= Legends =========
legend.fancybox: False
legend.fontsize: 8
legend.title_fontsize: 8

# ========= Patches =========
patch.linewidth: 0.5

# ========= PDF / PS output =========
pdf.fonttype: 42
ps.fonttype: 42

# ========= Color cycle =========
axes.prop_cycle: cycler('color', ['4c72b0', '55a868', 'c44e52', 'da8bc3', '64b5cd'])